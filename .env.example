# Local app configuration
LEASH_WEBHOOK_TOKEN=replace-with-a-long-demo-secret
LEASH_ADMIN_TOKEN=replace-with-a-long-demo-admin-secret
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
OTEL_EXPORTER_OTLP_INSECURE=true

# Docker app configuration. Override the OTLP endpoint if your Docker engine
# cannot resolve host.docker.internal.
DOCKER_OTEL_EXPORTER_OTLP_ENDPOINT=host.docker.internal:4317
